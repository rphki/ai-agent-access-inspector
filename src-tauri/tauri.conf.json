{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Agent Access Inspector",
  "identifier": "io.github.rphki.ai-agent-access-inspector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AI Agent Access Inspector",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AI Agent Access Inspector contributors",
    "copyright": "Copyright 2026 the AI Agent Access Inspector contributors. Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Shows which folders local AI agents can access",
    "longDescription": "A read-only desktop tool that shows which folders local AI agents such as Claude Code can access according to their configuration. It changes nothing and sends no data.",
    "licenseFile": "../LICENSE",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
